rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Products images - uploaded by authenticated admins only, readable by all
    match /products/{imageId} {
      // Allow public read access for product images
      allow read: if true;
      
      // Only authenticated users (admins) can upload/update/delete
      allow write: if request.auth != null;
    }
    
    // Pop-up images - uploaded by authenticated admins only, readable by all
    match /popups/{imageId} {
      // Allow public read access for pop-up images
      allow read: if true;
      
      // Only authenticated users (admins) can upload/update/delete
      allow write: if request.auth != null;
    }
    
    // Review photos - anyone can upload (for customer reviews), readable by all
    match /review_photos/{allPaths=**} {
      // Allow public read access for review photos
      allow read: if true;
      
      // Allow anyone to upload review photos (customers don't need to be authenticated)
      // Limit file size to 5MB for security
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Reviews folder (alternative path used by review.html)
    match /reviews/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    
    // LatiaoGRAM posts - public uploads for social media
    match /latiaogram_posts/{imageId} {
      // Allow public read access for LatiaoGRAM images
      allow read: if true;
      
      // Allow anyone to upload LatiaoGRAM photos
      // Limit file size to 10MB and only images
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
