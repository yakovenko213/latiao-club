rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 🔓 DEVELOPMENT MODE: Allow all operations for emulator testing
    // This rule allows read/write access to all documents for any user
    // ⚠️  WARNING: This is ONLY for emulator use - NEVER deploy to production!
    match /{document=**} {
      allow read, write: if true;
    }
  }
}