rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =============================================
    // 🌐 PUBLIC COLLECTIONS (Anyone can read)
    // =============================================
    
    // Products - PUBLIC READ for storefront
    match /products/{productId} {
      allow read: if true;                    // Anyone can browse products
      allow write: if request.auth != null;   // Only admins can modify
    }
    
    // Categories - PUBLIC READ for navigation
    match /categories/{categoryId} {
      allow read: if true;                    // Anyone can see categories
      allow write: if request.auth != null;   // Only admins can modify
    }
    
    // Pages/Content - PUBLIC READ for static pages
    match /pages/{pageId} {
      allow read: if true;                    // Anyone can read pages
      allow write: if request.auth != null;   // Only admins can modify
    }
    
    // Settings - PUBLIC READ for site config (gifts, delivery, etc.)
    match /settings/{docId} {
      allow read: if true;                    // Anyone can read settings
      allow write: if request.auth != null;   // Only admins can modify
    }
    
    // Pop-ups - PUBLIC READ for marketing modals
    match /popups/{popupId} {
      allow read: if true;                    // Anyone can see active popups
      allow write: if request.auth != null;   // Only admins can modify
    }
    
    // Promocodes - PUBLIC READ for validation at checkout
    match /promocodes/{promoId} {
      allow read: if true;                    // Anyone can validate promo codes
      allow write: if request.auth != null;   // Only admins can create/modify
    }
    
    // =============================================
    // 🛒 ORDERS (Create: Public, Read: Auth only)
    // =============================================
    
    match /orders/{orderId} {
      allow create: if true;                  // Anyone can place an order
      allow read: if request.auth != null;    // Only authenticated users can read
      allow update, delete: if request.auth != null;  // Only admins can modify
    }
    
    // =============================================
    // 👤 CUSTOMERS (Private - Auth only)
    // =============================================
    
    match /customers/{customerId} {
      allow read, write: if request.auth != null;  // Only authenticated users
    }
    
    // Personal promo codes - Private
    match /personal_promocodes/{promoId} {
      allow read: if request.auth != null;    // Only authenticated users can read
      allow write: if request.auth != null;   // Only admins can create
    }
    
    // =============================================
    // 🛒 ABANDONED CARTS (Semi-public)
    // =============================================
    
    match /abandoned_carts/{cartId} {
      allow create, update, delete: if true;  // Clients can save/delete their cart
      allow read: if request.auth != null;    // Only admins can view all carts
    }
    
    // =============================================
    // 📊 ANALYTICS (Write: Public, Read: Admin)
    // =============================================
    
    match /daily_stats/{dateId} {
      allow read: if request.auth != null;    // Only admins can read stats
      allow create, update: if true;          // Anyone can increment counters
    }
    
    // =============================================
    // 🔒 CATCH-ALL: Deny everything else
    // =============================================
    
    match /{document=**} {
      allow read, write: if false;            // Deny access to undefined collections
    }
  }
}
