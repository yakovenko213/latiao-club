rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // CUSTOMERS COLLECTION - ENHANCED SECURITY
    // ============================================
    match /customers/{customerId} {
      // Read: Allow authenticated users to read
      allow read: if request.auth != null;
      
      // Write: Allow authenticated users + phone validation
      allow write: if request.auth != null 
        && isValidCustomerData(request.resource.data);
    }
    
    // Validation function for customer data
    function isValidCustomerData(data) {
      return data.phone is string
        && data.phone.size() >= 10
        && data.phone.size() <= 13
        && data.phone.matches('^[0-9+]+$') // Only digits and plus
        && (data.fullName is string || !('fullName' in data))
        && (data.email is string || !('email' in data))
        && data.ordersCount is number
        && data.totalSpent is number;
    }
    
    // =============================================
    // 📊 ANALYTICS - MUST BE FIRST (Public Write)
    // =============================================
    
    // Real-time Cart Analytics - Track "Add to Cart" events
    // CRITICAL: Public create for unauthenticated tracking
    match /analytics_cart_adds/{eventId} {
      allow create: if true;                  // ✅ ANYONE can track cart add event
      allow read: if request.auth != null;    // Only admins can view analytics
      allow update, delete: if request.auth != null;
    }
    
    // Session Tracking - Track unique visitors
    // Uses setDoc with merge so sessions can be updated
    // ALSO used for device tracking via addDoc (visitor-tracker.js)
    match /analytics_sessions/{sessionId} {
      allow create, update: if true;          // ✅ Public - track visits & heartbeats
      allow read: if request.auth != null;    // Admin reads for analytics
      allow delete: if request.auth != null;
    }
    
    // Checkout Events - Track when users reach checkout
    match /analytics_checkout_events/{eventId} {
      allow create, update: if true;          // ✅ Public - user visited checkout
      allow read: if request.auth != null;    // Admin reads for analytics
      allow delete: if request.auth != null;
    }
    
    // Behavior Analytics - Time tracking (time to cart, checkout speed, etc.)
    match /analytics_timings/{timingId} {
      allow create: if true;                  // ✅ Public - anyone can track timing
      allow read: if request.auth != null;    // Admin reads for analytics
      allow update, delete: if request.auth != null;
    }
    
    // Favorites Analytics - Track which products users add to favorites
    // Full public access for seamless tracking without authentication
    match /analytics_favorites/{productId} {
      allow read, write: if true;
    }
    
    // Shared Carts - Collaborative shopping with shareable links
    // Anyone with the cart ID (link) can read and update the cart
    match /shared_carts/{cartId} {
      allow read, write: if true;
    }
    
    // Daily Stats
    match /daily_stats/{dateId} {
      allow read: if request.auth != null;
      allow create, update: if true;          // Anyone can increment counters
    }
    
    // =============================================
    // 📱 SMS QUEUE - Server-side SMS Scheduling
    // =============================================
    // Used by Cloud Function to process scheduled SMS messages
    // Admin creates queue entries, Cloud Function processes them
    match /sms_queue/{queueId} {
      // ✅ Admin can create and read queue entries
      allow read, create: if request.auth != null;
      // ✅ Cloud Functions can update status (no auth needed for server)
      // Admin can also update/delete for management
      allow update, delete: if request.auth != null;
    }
    
    // SMS Logs - Tracking sms scheduler runs (Cloud Function only writes)
    match /sms_logs/{logId} {
      allow read: if request.auth != null;  // Admin can view logs
      // Cloud Functions bypass rules with admin SDK
    }
    
    // =============================================
    // � FREE ORDERS - Public Giveaway Submissions
    // =============================================
    // Anyone can submit a free order request (for giveaway campaigns)
    // Only admins can read/manage these orders
    match /free_orders/{orderId} {
      allow create: if true;                  // ✅ PUBLIC - anyone can submit giveaway form
      allow read, update, delete: if request.auth != null; // ❌ Only admins can manage
    }
    
    // =============================================
    // 👥 LIVE VISITORS - Real-time presence tracking
    // =============================================
    match /free_latyao_visitors/{visitorId} {
      allow read: if true;                    // ✅ PUBLIC - anyone can see visitor count
      allow create, update: if true;          // ✅ PUBLIC - visitors can register/heartbeat
      allow delete: if true;                  // ✅ PUBLIC - visitors can leave & cleanup old records
    }
    
    // =============================================    // 📊 STATS - Page View Tracking
    // =============================================
    // Public write access for tracking page views and statistics
    match /stats/{docId} {
      allow read: if true;                    // ✅ PUBLIC - anyone can see view counts
      // Allow public to write to free_page_views document
      allow write: if docId == 'free_page_views';
    }
    
    // =============================================    // �🌐 PUBLIC COLLECTIONS (Anyone can read)
    // =============================================
    
    // Products - PUBLIC READ for storefront
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Categories - PUBLIC READ for navigation
    match /categories/{categoryId} {
      allow read: if true;
      // Allow public to update viewCount and lastViewed fields only (for tracking)
      // This enables auto-creation of viewCount field via setDoc with merge
      allow update: if request.auth == null 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'lastViewed'])
                    && request.resource.data.viewCount is number;
      // Allow authenticated users (admins) to update any field
      allow create, delete, update: if request.auth != null;
    }
    
    // Pages/Content - PUBLIC READ for static pages
    match /pages/{pageId} {
      allow read: if true;
      // Allow public to update viewCount and lastViewed fields only (for tracking)
      // This enables auto-creation of viewCount field via setDoc with merge
      allow update: if request.auth == null 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'lastViewed'])
                    && request.resource.data.viewCount is number;
      // Allow authenticated users (admins) to update any field
      allow create, delete, update: if request.auth != null;
    }
    
    // Settings - PUBLIC READ for site config (gifts, delivery, etc.)
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Config - ADMIN ONLY for system configuration (TurboSMS, etc.)
    // EXCEPTION: general_config is PUBLIC READ for cashback switch
    match /config/general_config {
      // ✅ PUBLIC READ - website needs to check isCashbackEnabled without auth
      allow read: if true;
      // ❌ WRITE restricted to authenticated admins only
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // EXCEPTION: giveaway is PUBLIC READ for free-latyao.html
    match /config/giveaway {
      // ✅ PUBLIC READ - public page needs to check if giveaway is active
      allow read: if true;
      // ❌ WRITE restricted to authenticated admins only
      allow write: if request.auth != null;
    }
    
    match /config/{docId} {
      // ❌ Only ADMINS can read/write config (contains sensitive data like API keys)
      allow read, write: if request.auth != null;
    }
    
    // Pop-ups - PUBLIC READ for marketing modals
    // Public UPDATE for stats fields only (viewsCount, clicksCount, closeCount)
    match /popups/{popupId} {
      allow read: if true;
      // Full write for authenticated admins
      allow create, delete: if request.auth != null;
      // Allow updates: admins can update everything, anonymous can update only stats
      allow update: if request.auth != null || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'clicksCount', 'closeCount']));
    }
    
    // Promocodes - PUBLIC READ for validation at checkout
    match /promocodes/{promoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Upsells - PUBLIC READ for product recommendations
    match /upsells/{upsellId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // =============================================
    // 💰 UPSELL SETTINGS & STATISTICS (Admin Panel Integration)
    // =============================================
    
    // Upsell Settings - Configuration and Statistics
    // Documents: 'config' (settings), 'stats' (tracking data)
    match /upsell_settings/{document} {
      // ✅ PUBLIC READ - Customers need to see if upsell is enabled and settings
      allow read: if true;
      
      // ✅ WRITE rules vary by document:
      // - 'config': Only authenticated admins can update settings
      // - 'stats': Anyone can update (for tracking views/conversions/revenue)
      allow create, delete: if request.auth != null; // Only admins can create/delete documents
      allow update: if request.auth != null  // Admins can update anything
                    || document == 'stats';   // OR anyone can update stats for tracking
    }
    
    // ============================================
    // ⭐ USER FAVORITES - Cloud Sync Storage
    // ============================================
    // Users can save/restore favorites using phone number as document ID
    // Public read/write for seamless sync without authentication
    match /user_favorites/{phone} {
      allow read, write: if true;
    }
    
    // ==============================================
    // 🛒 ORDERS (Public read for phone-based auth)
    // =============================================
    
    match /orders/{orderId} {
      allow create: if true;  // Anyone can place an order
      
      // ✅ Anyone can read a SPECIFIC order (if they know the ID)
      // This is needed for thank-you page and phone-based auth
      allow get: if true;
      
      // ✅ List operations allowed for everyone (filtered by frontend)
      // This is needed for dashboard.html with phone-based auth
      allow list: if true;
      
      // ✅ LINK TRACKING: Allow public update of ONLY linkOpened/linkOpenedAt fields
      // This is needed for leave-review.html to track when customer opens review link
      allow update: if request.auth != null  // Admins can update anything
        || (
          // OR public users can ONLY update these exact 2 fields (nothing else)
          // This ensures they cannot modify total, status, customer data, etc.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkOpened', 'linkOpenedAt'])
        );
      
      // ✅ Only authenticated admins can delete
      allow delete: if request.auth != null;
    }

    // =============================================
    // 👤 USERS (Public read for phone-based auth)
    // =============================================
    
    match /users/{userId} {
      // ✅ PUBLIC - needed for phone login check
      allow read: if true;
      // ✅ Anyone can write (for phone registration)
      allow write: if true;
    }

    // =============================================
    // 👤 CUSTOMERS (Public read for phone-based auth)
    // =============================================

    match /customers/{customerId} {
      // ✅ Anyone can read customer data (needed for phone-based auth)
      // Frontend filters by phone for security
      allow read: if true;
      // ✅ Anyone can write/update (for phone registration)
      allow write: if true;
    }

    // Personal promo codes
    match /personal_promocodes/{promoId} {
      allow read, write: if request.auth != null;
    }
    
    // =============================================
    // 🛒 ABANDONED CARTS (Semi-public)
    // =============================================
    
    match /abandoned_carts/{cartId} {
      allow create, update, delete: if true;  // Clients can save/delete their cart
      allow read: if request.auth != null;    // Only admins can view all carts
    }
    
    // =============================================
    // 🎯 CRM COLUMNS (Admin only)
    // =============================================
    
    match /crm_columns/{columnId} {
      allow read, write: if request.auth != null;  // Only authenticated admins
    }
    
    // =============================================
    // 💬 LIVE CHAT (Public create for unauthenticated users)
    // =============================================
    
    // Chat sessions - Each chat is identified by a unique session ID
    match /chats/{chatId} {
      // ✅ Anyone can CREATE a new chat session
      allow create: if true;
      
      // ✅ Anyone can READ their own chat (they need chatId to access)
      // Security: chatId is a random session ID, so only the chat owner knows it
      allow read: if true;
      
      // ✅ Anyone can UPDATE (for lastMessage updates from client)
      // Admins also need this to update chat metadata
      allow update: if true;
      
      // ❌ Only authenticated admins can delete chats
      allow delete: if request.auth != null;
      
      // Messages subcollection
      match /messages/{messageId} {
        // ✅ Anyone can READ messages in their chat session
        // (they need to know the chatId to access)
        allow read: if true;
        
        // ✅ CREATE rules:
        // - Unauthenticated users can ONLY send as 'client'
        // - Authenticated admins can send as 'admin' or 'bot'
        allow create: if request.resource.data.sender == 'client' 
                      || request.auth != null;
        
        // ❌ Only authenticated admins can update/delete messages
        allow update, delete: if request.auth != null;
      }
    }
    
    // =============================================
    // ⭐ REVIEWS (Pre-moderation system)
    // =============================================
    
    match /reviews/{reviewId} {
      // ✅ PUBLIC can READ all reviews
      allow read: if true;
      
      // ✅ ANYONE can CREATE a review (no restrictions)
      // We validate status='pending' in frontend code instead
      allow create: if true;
      
      // ❌ Only ADMINS can UPDATE or DELETE reviews
      allow update, delete: if request.auth != null;
    }
    
    // =============================================
    // 🔔 RESTOCK NOTIFICATIONS
    // =============================================
    
    match /restock_requests/{requestId} {
      // ✅ PUBLIC can CREATE restock requests (customers notify about out-of-stock)
      allow create: if true;
      
      // ❌ Only ADMINS can READ, UPDATE, or DELETE restock requests
      allow read, update, delete: if request.auth != null;
    }
    
    // =============================================
    // 📣 BROADCAST / MAILING
    // =============================================
    
    match /broadcasts/{broadcastId} {
      // ❌ Only ADMINS can manage broadcasts
      allow read, write: if request.auth != null;
    }
    
    // =============================================
    // ⚙️ ADMIN SETTINGS
    // =============================================
    
    match /admin_settings/{settingId} {
      // ❌ Only ADMINS can manage settings (restock templates, etc.)
      allow read, write: if request.auth != null;
    }
    
    // =============================================
    // 📱 SMS LOGS
    // =============================================
    
    match /sms_logs/{logId} {
      // ❌ Only ADMINS can read/write SMS logs
      allow read, write: if request.auth != null;
    }
    
    // =============================================
    // 💰 CASHBACK TRANSACTIONS (Admin only)
    // =============================================
    
    match /cashback_transactions/{transactionId} {
      // ✅ Admins can read all transactions (for statistics dashboard)
      allow read: if request.auth != null;
      // ✅ System can create transactions (order completion, manual credit/debit)
      allow create: if true;
      // ❌ Only admins can update/delete
      allow update, delete: if request.auth != null;
    }

    // =============================================
    // 📱 LATIAOGRAM SOCIAL MEDIA
    // =============================================
    
    match /latiaogram_feed/{postId} {
      // ✅ Everyone can read posts (public feed)
      allow read: if true;
      
      // ✅ Anyone can create new posts (with validation)
      allow create: if isValidLatiaoPost(request.resource.data);
      
      // ✅ Anyone can increment likes (with validation)
      allow update: if onlyLikeIncrement(resource.data, request.resource.data);
      
      // ❌ No direct deletion (only admins via backend)
      allow delete: if false;
    }
    
    // Validation function for LatiaoGRAM posts
    function isValidLatiaoPost(data) {
      return data.nickname is string
        && data.nickname.size() >= 2 
        && data.nickname.size() <= 30
        && data.caption is string
        && data.caption.size() <= 500
        && data.imageUrl is string
        && (data.imageUrl.matches("^https://.*") || data.imageUrl.matches("^data:image/.*"))
        && data.likes == 0
        && data.createdAt is timestamp;
    }
    
    // Function to only allow like increments
    function onlyLikeIncrement(before, after) {
      return before.diff(after).affectedKeys().hasOnly(['likes'])
        && after.likes >= before.likes  // Only allow increases
        && after.likes <= before.likes + 1;  // Only increment by 1
    }

  }
}