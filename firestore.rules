rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Orders collection - allow clients to create and read their own orders
    match /orders/{orderId} {
      allow create: if true; // Anyone can create orders
      // Allow read if:
      // 1. User is authenticated (admin), OR
      // 2. User is anonymous (for client dashboard - validated by phone in query)
      allow read: if request.auth != null; 
      allow update, delete: if request.auth != null && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
    }
    
    // Customers collection - allow clients to read/update their own profile
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }
    
    // Personal promo codes - allow reading by authenticated users
    match /personal_promocodes/{promoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
    }
    
    // Abandoned carts - allow clients to create/update/delete, admins to read
    match /abandoned_carts/{phone} {
      allow create, update, delete: if true; // Anyone can save/delete their abandoned cart
      allow read: if request.auth != null; // Only admins can read
    }
    
    // Products collection - read-only for clients, full access for admins
    match /products/{productId} {
      allow read: if true; // Anyone can read products
      allow write: if request.auth != null; // Only admins can modify
    }
    
    // Settings collection - read-only for clients (for gifts/popups), full access for admins
    match /settings/{docId} {
      allow read: if true; // Anyone can read settings
      allow write: if request.auth != null; // Only admins can modify
    }
    
    // Pop-ups collection - read-only for clients, full access for admins
    match /popups/{popupId} {
      allow read: if true; // Anyone can read active popups
      allow write: if request.auth != null; // Only admins can modify
    }
    
    // Pages collection - read-only for clients, full access for admins
    match /pages/{pageId} {
      allow read: if true; // Anyone can read pages
      allow write: if request.auth != null; // Only admins can modify
    }
    
    // Daily stats collection - public write access for analytics tracking
    match /daily_stats/{dateId} {
      allow read: if request.auth != null; // Only admins can read stats
      allow create, update: if true; // Anyone can increment counters (visitors, cart additions)
    }
  }
}
